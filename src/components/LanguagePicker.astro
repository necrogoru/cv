---
import { languages } from '@/i18n/ui';
import { LANG_COOKIE } from '@/i18n/utils';
import type { Lang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class="flex gap-4 items-center">
  {Object.entries(languages).map(([langCode, label]) => (
    <li>
      <button
        type="button"
        data-lang={langCode}
        class:list={[
          "px-3 py-1 rounded cursor-pointer",
          langCode === lang ? "bg-yellow-500 font-semibold" : "hover:bg-gray-200"
        ]}
      >
        {label}
      </button>
    </li>
  ))}
</ul>

<script define:vars={{ cookieName: LANG_COOKIE, base }}>
  document.querySelectorAll('button[data-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      document.cookie = `${cookieName}=${lang};path=${base || '/'};max-age=31536000;samesite=lax`;
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang;
      document.querySelectorAll('button[data-lang]').forEach((b) => {
        const active = b.getAttribute('data-lang') === lang;
        b.classList.toggle('bg-yellow-500', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('hover:bg-gray-200', !active);
      });
    });
  });
</script>
